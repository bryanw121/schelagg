# Copy to .env (same folder) for local runs on macOS, Linux or Windows. Optional.
# SITE_URL: where npm run courts fetches the last good courts.json if none is local.
SITE_URL=https://bryanw121.github.io/schelagg/
# CHROMIUM_PATH: an already-installed Chromium for npm run test:e2e, instead of `npx playwright install chromium`.
# CHROMIUM_PATH=/path/to/chrome
# DATABASE_URL: Schelagg's Postgres (Neon) owner connection string, for npm run db:migrate and npm run scrape.
# Unset = no database; everything still works from the JSON files.
# DATABASE_URL=postgresql://<owner>:<password>@<host>/<db>?sslmode=require
# DATABASE_URL_READONLY: the schelagg_reader role's connection string, for /api/sessions and /api/check (npm run dev).
# DATABASE_URL_READONLY=postgresql://schelagg_reader:<password>@<host>/<db>?sslmode=require
# BRAVE_SEARCH_API_KEY: Brave Search API key for node scripts/discover-reclub.mjs (finding new Reclub clubs).
# BRAVE_SEARCH_API_KEY=<key>
